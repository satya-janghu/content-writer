# Google Gemini API key (https://aistudio.google.com/apikey).
# Required: propose.py (gemini-3.1-pro-preview) and regen.py (gemini-3-flash-preview)
# call Gemini, and analyze_competitors.py uses it to generate GEO simulation queries.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the eval_server Unix socket path.
# EVAL_SERVER_SOCKET=/tmp/content-writer-eval.sock
